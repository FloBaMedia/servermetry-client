# Copy to .env and fill in the key from the ServerMetry dashboard
# (Servers → add server → API key, shown once).

SERVERMETRY_API_URL=https://api.servermetry.com
SERVERMETRY_API_KEY=sp_live_...
SERVERMETRY_DEBUG=0
# Seconds between reports. Overrides the dashboard report interval when set.
SERVERMETRY_INTERVAL=60
